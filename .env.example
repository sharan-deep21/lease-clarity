# =====================================================================
# Rental Agreement Assistant - Environment Configuration
# =====================================================================
# Copy this file to .env and configure with your own credentials.
# NEVER commit your actual .env file to version control.
# =====================================================================

# Gemini API Key (Required for LLM analysis, summary, risk detection, Q&A)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Maximum upload file size in Megabytes (Strict server-side enforcement: 5MB)
MAX_FILE_SIZE_MB=5

# Rate limiting (requests allowed per IP per minute for analysis/upload)
RATE_LIMIT_PER_MINUTE=20

# Server host and port
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
